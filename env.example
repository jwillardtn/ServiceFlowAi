# ============================================================
# ServiceFlow AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Anthropic (required for AI chat)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar (optional)
# Create credentials at: https://console.cloud.google.com
# Enable: Google Calendar API
# Create OAuth2 credentials, add redirect URI: http://localhost:3000/api/calendar/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Twilio SMS (optional — for missed call text-back)
# Sign up free at: https://twilio.com
# 1. Get Account SID + Auth Token from your Twilio console
# 2. Buy a phone number (~$1/mo)
# 3. Set the number's "A call comes in" webhook to: http://your-domain.com/api/twilio/missed-call
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+18135550100
